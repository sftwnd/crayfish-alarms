<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <!-- the modules have the url and the scm of the repository, without their artifactId appended
         (child.*.inherit.append.path): the headers Bundle-DocURL and Bundle-SCM of their bundles name the repository.
         The start tags of project and scm stay on one line each, as release:prepare writes them -->
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <groupId>com.github.sftwnd.crayfish.alarms</groupId>
    <artifactId>crayfish-alarms</artifactId>
    <version>1.1.0-SNAPSHOT</version>

    <name>CrayFish :: ALARMS</name>

    <description>
        The library contains primitives that allow you to control the installation of tasks for processing on a schedule
    </description>
    <url>https://github.com/sftwnd/crayfish-alarms</url>

    <licenses>
        <license>
            <name>3-Clause BSD License</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>sftwnd</id>
            <name>Andrey Shindarev</name>
            <email>ashindarev@gmail.com</email>
            <timezone>Europe/Moscow</timezone>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <url>https://github.com/sftwnd/crayfish-alarms</url>
        <connection>scm:git:https://github.com/sftwnd/crayfish-alarms.git</connection>
        <developerConnection>scm:git:git@github.com:sftwnd/crayfish-alarms.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>crayfish-alarms-timerange</module>
        <module>crayfish-alarms-service</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the time of the entries of the jars, for reproducible builds: maven-release-plugin sets the time of the
             release at release:prepare; without the property the super POM of Maven 3.10 sets 1980-02-01 -->
        <project.build.outputTimestamp>2023-06-16T16:04:02Z</project.build.outputTimestamp>
        <maven.plugin.validation>BRIEF</maven.plugin.validation>
        <!-- the classes are compiled for Java 8, the module descriptors (src/main/java9) for Java 9+ -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <crayfish-common-expectation.version>1.4.0</crayfish-common-expectation.version>
        <spotbugs-annotations.version>4.10.5</spotbugs-annotations.version>
        <!-- JUnit 6 requires Java 17: the tests run on Java 8 as well -->
        <junit.version>5.14.4</junit.version>
        <!-- the sources jar is built by maven-jar-plugin (the execution attach-sources): maven-source-plugin, which the
             release profile of the super POM of Maven 3.9 (-DperformRelease=true) uses as well, is skipped, so that it
             attaches no sources jar of its own -->
        <maven.source.skip>true</maven.source.skip>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <!-- 3.11.0+: compileSourceRoots can be configured, for the module descriptors in src/main/java9 -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <!-- dependency:build-classpath of .github/scripts/check-modular-jar.sh -->
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-release-plugin.version>3.3.1</maven-release-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <!-- 0.8.14+: the tests run on JDK 25 as well -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- the scanner of the job SonarCloud of the CI, which runs on Java 21 -->
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>
        <!-- bnd 7 requires Java 17, the build runs on Java 8 -->
        <bnd-maven-plugin.version>6.4.0</bnd-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <!-- the best practices of maven-gpg-plugin: the passphrase of the signing key comes from gpg-agent (or from
             MAVEN_GPG_PASSPHRASE), not from a server of the settings, see the profile sign-artifacts -->
        <gpg.bestPractices>true</gpg.bestPractices>
    </properties>

    <dependencies>
        <!-- optional: NonNull/Nullable are CLASS-retention marker annotations, consumers need neither this jar
             nor its dependency jsr305 (package javax.annotation) to compile or to run -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-processing</arg>
                        <!-- JDK 21+ reports Java 8 as an obsolete target; Java 8 stays the target of the library -->
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>
            <plugin>
                <!-- the sources of the sources jar, which mirrors the multi-release jar: those of src/main/java at the
                     root, those of src/main/java9 in META-INF/versions/9 (copied in the profile release-8-on-jdk9+, which
                     compiles them). maven-source-plugin takes the source roots of the project, and src/main/java9 is
                     compiled by an execution of its own, not as a source root -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-sources</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/sources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <source>${maven.compiler.source}</source>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <!-- OSGi bundle headers -->
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- not in target/classes: there its Automatic-Module-Name makes javac take target/classes for the module
                         when it compiles module-info.java in an incremental build -->
                    <manifestPath>${project.build.directory}/bnd/MANIFEST.MF</manifestPath>
                    <bnd><![CDATA[
Bundle-SymbolicName: ${bundleSymbolicName}
Bundle-License: BSD-3-Clause;link="https://opensource.org/licenses/BSD-3-Clause"
# the name of the module of a jar built on JDK 8, which has no module descriptor
Automatic-Module-Name: ${javaModuleName}
Multi-Release: true
# bnd 6 does not know multi-release jars and takes the module descriptor of META-INF/versions/9 for a class in the
# wrong directory
-fixupmessages: "Classes found in the wrong directory: *META-INF/versions/9/*";restrict:=error;is:=ignore
# the package of the bundle has the name of the bundle and the version of the release; the CLASS-retention SpotBugs
# annotations are not imported
Export-Package: ${bundleSymbolicName};version="${version;===;${Bundle-Version}}"
-noextraheaders: true
# snapshot builds get the version qualifier SNAPSHOT instead of a timestamp, so that they are reproducible
-snapshot: SNAPSHOT
]]></bnd>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <!-- the manifest of bnd-maven-plugin: the headers of the bundle, Automatic-Module-Name and
                             Multi-Release -->
                        <manifestFile>${project.build.directory}/bnd/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <!-- the sources jar of the sources copied by maven-resources-plugin; the parent project has none -->
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>sources</classifier>
                            <classesDirectory>${project.build.directory}/sources</classesDirectory>
                            <skipIfEmpty>true</skipIfEmpty>
                            <!-- the default manifest, not that of the jar -->
                            <archive combine.self="override" />
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <configuration>
                    <mavenExecutorId>forked-path</mavenExecutorId>
                    <!-- the release profile of the super POM is not used: useReleaseProfile (deprecated) is false by
                         default -->
                    <releaseProfiles>sign-artifacts</releaseProfiles>
                </configuration>
            </plugin>
            <plugin>
                <!-- deploy publishes to the Central Publisher Portal (server id "central" with a Portal user token in
                     settings.xml): one deployment of the parent POM and both modules, which stays VALIDATED until it is
                     published by hand (autoPublish is false by default) -->
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- the name of the project, not ${project.artifactId}: the plugin uploads the deployment from the last
                         module of the reactor -->
                    <deploymentName>crayfish-alarms-${project.version}</deploymentName>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- the version of the default lifecycle, whose execution the extension of central-publishing removes,
                         and of the release profile of the super POM of Maven 3.9 (-DperformRelease=true) -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- skipped (maven.source.skip); the version for the release profile of the super POM of Maven 3.9 -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>${maven-release-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>biz.aQute.bnd</groupId>
                    <artifactId>bnd-maven-plugin</artifactId>
                    <version>${bnd-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- SonarCloud analysis in the GitHub Actions workflow -->
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.sftwnd.crayfish.common</groupId>
                <artifactId>crayfish-common-expectation</artifactId>
                <version>${crayfish-common-expectation.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.sftwnd.crayfish.alarms</groupId>
                <artifactId>crayfish-alarms-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.sftwnd.crayfish.alarms</groupId>
                <artifactId>crayfish-alarms-timerange</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs-annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <!-- compile against the Java 8 API on JDK 9+ (-source/-target alone do not check the API) -->
            <id>release-8-on-jdk9+</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <!-- the module descriptor, compiled for Java 9 into META-INF/versions/9: a named module on
                             Java 9+, while Java 8 ignores it (a build on JDK 8 produces a jar without it) -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-module-info</id>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>9</release>
                                    <multiReleaseOutput>true</multiReleaseOutput>
                                    <compilerArgs combine.children="append">
                                        <!-- a lint category of Java 9+: the spotbugs annotations jar is an automatic module -->
                                        <arg>-Xlint:-requires-automatic</arg>
                                    </compilerArgs>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                                    </compileSourceRoots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- the sources of src/main/java9 in the sources jar, in META-INF/versions/9 as their classes in
                             the jar -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-sources-9</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/sources/META-INF/versions/9</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/java9</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>sign-artifacts</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <!-- a jar built on JDK 8 has no module descriptor -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${maven-enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>release-on-jdk9+</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[9,)</version>
                                            <message>A release has to be built on JDK 9+, so that the jars contain the module descriptors</message>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <!-- the passphrase of the key comes from gpg-agent: before the release unlock the key
                                     with any signature of gpg outside of the batch mode, so that gpg-agent caches it.
                                     In batch mode the plugin runs gpg with the pinentry mode "error": a locked key fails
                                     without a prompt. -Dgpg.bestPractices=false takes the passphrase of the server
                                     gpg.passphrase of the settings instead -->
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>